# Database Configuration
# Default uses SQLite for immediate testing, or uncomment MySQL configuration:
DATABASE_URL=sqlite:///./campusiq.db
# DATABASE_URL=mysql+pymysql://campusiq_app:campusiq_pass@localhost:3306/campusiq

# Security & JWT
SECRET_KEY=campusiq-super-secret-development-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ATTENDANCE_THRESHOLD=75.0
AT_RISK_GPA_THRESHOLD=5.0
MAX_UPLOAD_MB=10
