{
  "name": "campusiq-backend",
  "version": "1.0.0",
  "description": "CampusIQ Python FastAPI Backend Service",
  "scripts": {
    "dev": "powershell -Command \"& .venv\\Scripts\\uvicorn.exe app.main:app --reload --port 8000\"",
    "start": "powershell -Command \"& .venv\\Scripts\\uvicorn.exe app.main:app --port 8000\"",
    "test": "powershell -Command \"& .venv\\Scripts\\pytest.exe\"",
    "seed": "powershell -Command \"& .venv\\Scripts\\python.exe app\\scripts\\seed_data.py\""
  }
}
